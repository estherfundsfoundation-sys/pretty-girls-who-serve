{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/p31", "destination": "/p31.html" },
    { "source": "/mypgws", "destination": "/p31.html" },
    { "source": "/chapters", "destination": "/chapters.html" },
    { "source": "/start-a-chapter", "destination": "/chapters.html" },
    { "source": "/chapter-resources", "destination": "/chapters.html" },
    { "source": "/plans/pretty-girls-overcome", "destination": "/overcome.html" },
    { "source": "/pgws-admin", "destination": "/pgws-admin.html" }
  ],
  "headers": [
    {
      "source": "/pgws-admin",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
